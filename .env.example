# Apple WeatherKit credentials. Copy this file to .env and replace the values.
# The Flask application does not automatically load .env; export these values
# in your shell or use a process manager that supports environment files.
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_weatherkit_key_id
APPLE_SERVICE_ID=com.example.weather
APPLE_KEY_FILE=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8

# Shared secret required in the X-Weather-Key request header.
WEATHER_API_KEY=replace_with_a_long_random_value

# Optional fallback when a timezone cannot be resolved from the coordinates.
# Defaults to UTC.
WEATHERKIT_TIMEZONE=America/Denver

# ISO Alpha-2 country code used for WeatherKit alert availability. Defaults to US.
WEATHERKIT_COUNTRY_CODE=US

